void playBuzzer(int frequency, int duration) {
  #if defined(ESP32)
    ledcAttach(buzzerPin, frequency, 8);
    ledcWriteTone(buzzerPin, frequency);
    delay(duration);
    ledcWriteTone(buzzerPin, 0);
  #else
    tone(buzzerPin, frequency, duration);
    delay(duration);
  #endif
}

