void handleTimePlayingState() {
  if (digitalRead(btn5) == LOW) {
    playBuzzer(1200, 100);
    currentState = STATE_CONFIRM_EXIT;
    exitChoice = false;
    drawConfirmExitScreen();
    delay(250);
    return;
  }

  unsigned long now = millis();
  if (now - lastFrame < FRAME_TIME) return;
  lastFrame = now;

  if (timeShowingResult) {
    drawTimeGame(timeFrozenValue);
    if (now - timeResultShownAt > 900) {
      startNewTimeRound();
    }
    return;
  }

  if (!timeRoundRunning) {
    if (timeWaitingRelease) {
      if (digitalRead(btn4) == HIGH) timeWaitingRelease = false;
      drawTimeGame(0.0);
      return;
    }
    if (digitalRead(btn4) == LOW) {
      playBuzzer(1800, 60);
      timeRoundRunning = true;
      timeRoundStart = millis();
      timeWaitingRelease = true;
      drawTimeGame(0.0);
      return;
    }
    drawTimeGame(0.0);
    return;
  }

  float elapsedSec = (now - timeRoundStart) / 1000.0;
  float currentValue = fmod(elapsedSec * (10.0 / timeCycleSeconds), 10.0);

  if (timeWaitingRelease) {
    if (digitalRead(btn4) == HIGH) timeWaitingRelease = false;
    drawTimeGame(currentValue);
    return;
  }

  if (digitalRead(btn4) == LOW) {
    float diff = fabs(currentValue - timeTarget);
    if (diff > 2.0) diff = 2.0;
    int roundScore = (int)(1000.0 * (1.0 - diff / 2.0));
    if (roundScore < 0) roundScore = 0;

    timeGameScore += roundScore;
    if (timeGameScore > timeGameHighScore) timeGameHighScore = timeGameScore;

    timeLastDiff = diff;
    timeLastScore = roundScore;
    timeFrozenValue = currentValue;
    timeShowingResult = true;
    timeResultShownAt = now;
    timeRoundRunning = false;

    if (diff < 0.03) { strcpy(timeResultText, "PERFECT!"); playBuzzer(3000, 120); }
    else if (diff < 0.10) { strcpy(timeResultText, "GREAT!"); playBuzzer(2200, 90); }
    else if (diff < 0.30) { strcpy(timeResultText, "GOOD"); playBuzzer(1600, 70); }
    else if (diff < 0.60) { strcpy(timeResultText, "OK"); playBuzzer(1000, 60); }
    else { strcpy(timeResultText, "MISS"); playBuzzer(300, 100); }

    timeRoundCount++;
    timeCycleSeconds = 4.0 - (timeRoundCount * 0.15);
    if (timeCycleSeconds < 1.8) timeCycleSeconds = 1.8;

    drawTimeGame(timeFrozenValue);
    return;
  }

  drawTimeGame(currentValue);
}

void drawTimeGame(float currentValue) {
  canvas.fillScreen(DINO_BG);

  canvas.setTextSize(1);
  canvas.setTextColor(ST7735_WHITE);
  canvas.setCursor(4, 4);
  canvas.print("SC:");
  canvas.print(timeGameScore);

  canvas.setCursor(75, 4);
  canvas.print("HI:");
  canvas.print(timeGameHighScore);

  char tbuf[8];
  dtostrf(timeTarget, 4, 2, tbuf);
  canvas.setTextColor(LIGHT_BLUE);
  canvas.setCursor(28, 18);
  canvas.print("TARGET ");
  canvas.print(tbuf);

  float liveDiff = fabs(currentValue - timeTarget);
  uint16_t numColor = ST7735_WHITE;
  if (!timeShowingResult && timeRoundRunning && liveDiff < 0.3) {
    numColor = LIGHT_BLUE;
  }

  char vbuf[8];
  dtostrf(currentValue, 4, 2, vbuf);
  canvas.setTextSize(3);
  canvas.setTextColor(numColor);
  canvas.setCursor(20, 42);
  canvas.print(vbuf);

  int barX = 8, barY = 88, barW = 112, barH = 10;
  canvas.drawRect(barX, barY, barW, barH, ST7735_WHITE);
  int fillW = (int)((currentValue / 10.0) * (barW - 2));
  if (fillW < 0) fillW = 0;
  canvas.fillRect(barX + 1, barY + 1, fillW, barH - 2, LIGHT_BLUE);

  int tickX = barX + (int)((timeTarget / 10.0) * barW);
  canvas.drawFastVLine(tickX, barY - 3, barH + 6, ST7735_WHITE);

  canvas.setTextSize(1);
  canvas.setTextColor(ST7735_WHITE);
  canvas.setCursor(6, 116);
  if (timeShowingResult) {
    canvas.print("GET READY...");
  } else if (!timeRoundRunning) {
    canvas.print("PRESS B4 TO START");
  } else {
    canvas.print("B4:STOP  B5:EXIT");
  }

  if (timeShowingResult) {
    canvas.fillRoundRect(14, 55, 100, 24, 4, DINO_BG);
    canvas.drawRoundRect(14, 55, 100, 24, 4, LIGHT_BLUE);
    canvas.setTextColor(ST7735_WHITE);
    canvas.setTextSize(1);
    canvas.setCursor(20, 60);
    canvas.print(timeResultText);
    canvas.setCursor(20, 70);
    canvas.print("+");
    canvas.print(timeLastScore);
  }

  pushCanvas();
}

// =====================================================================
// DRAWING FUNCTIONS
// =====================================================================
void drawDinoGame() {
  canvas.fillScreen(DINO_BG);

  for (int i = 0; i < 3; i++) {
    canvas.fillRect(clouds[i].x, clouds[i].y, 12, 3, DINO_FG);
    clouds[i].x--;
    if (clouds[i].x < -15) clouds[i].x = 130;
  }

  canvas.drawFastHLine(0, 99, 128, DINO_FG);

  for (int i = 0; i < NUM_OBS; i++) {
    if (obstacles[i].x > -10 && obstacles[i].x < 135) {
      if (obstacles[i].isBird) {
        drawBird((int)obstacles[i].x, obstacles[i].y);
      } else {
        drawCactus((int)obstacles[i].x, obstacles[i].y, obstacles[i].w, obstacles[i].h);
      }
    }
  }

  drawDino((int)dinoX, (int)dinoY);

  canvas.setTextSize(1);
  canvas.setTextColor(DINO_FG);
  canvas.setCursor(4, 4);
  canvas.print("SC:");
  canvas.print(dinoScore);

  canvas.setCursor(75, 4);
  canvas.print("HI:");
  canvas.print(dinoHighScore);

  pushCanvas();
}

void drawFlappyGame() {
  canvas.fillScreen(DINO_BG);

  canvas.fillRect((int)pipeX, 0, pipeWidth, pipeGapY, DINO_FG);
  canvas.fillRect((int)pipeX - 2, pipeGapY - 4, pipeWidth + 4, 4, DINO_FG);

  int bottomPipeY = pipeGapY + pipeGapHeight;
  canvas.fillRect((int)pipeX, bottomPipeY, pipeWidth, 128 - bottomPipeY, DINO_FG);
  canvas.fillRect((int)pipeX - 2, bottomPipeY, pipeWidth + 4, 4, DINO_FG);

  drawFlappyBird(30, (int)birdY);

  canvas.setTextSize(1);
  canvas.setTextColor(DINO_FG);
  canvas.setCursor(4, 4);
  canvas.print("SC:");
  canvas.print(flappyScore);

  canvas.setCursor(75, 4);
  canvas.print("HI:");
  canvas.print(flappyHighScore);

  pushCanvas();
}

void drawDino(int x, int y) {
  canvas.fillRect(x + 4, y + 4, 8, 8, DINO_FG);
  canvas.fillRect(x + 8, y, 6, 6, DINO_FG);
  canvas.fillRect(x + 12, y + 1, 2, 2, DINO_BG);
  canvas.fillRect(x + 3, y + 12, 2, 4, DINO_FG);
  canvas.fillRect(x + 9, y + 12, 2, 4, DINO_FG);
  canvas.fillRect(x, y + 6, 4, 2, DINO_FG);
}

void drawFlappyBird(int x, int y) {
  canvas.fillRect(x, y + 2, 8, 6, DINO_FG);
  canvas.fillRect(x + 6, y + 1, 3, 3, DINO_FG);
  canvas.fillRect(x + 7, y + 2, 1, 1, DINO_BG);
  canvas.fillRect(x + 8, y + 3, 3, 2, DINO_RED);
  canvas.fillRect(x + 2, y, 3, 2, DINO_FG);
}

void drawCactus(int x, int y, int w, int h) {
  canvas.fillRect(x, y, w, h, DINO_FG);
  canvas.fillRect(x - 2, y + 4, 2, 5, DINO_FG);
  canvas.fillRect(x + w, y + 2, 2, 5, DINO_FG);
}

void drawBird(int x, int y) {
  canvas.fillRect(x + 2, y + 2, 6, 4, DINO_FG);
  canvas.fillRect(x, y, 4, 2, DINO_FG);
  canvas.fillRect(x + 6, y + 4, 4, 2, DINO_FG);
}

// =====================================================================
// GAME OVER & EXIT
// =====================================================================
void triggerGameOver() {
  playBuzzer(300, 150);
  digitalWrite(led1, HIGH);
  digitalWrite(led2, HIGH);
  delay(150);
  digitalWrite(led1, LOW);
  digitalWrite(led2, LOW);

  currentState = STATE_GAMEOVER;
  drawGameOverScreen();
}

void drawGameOverScreen() {
  canvas.fillScreen(DINO_BG);
  canvas.drawRect(7, 14, 114, 99, DINO_RED);

  canvas.setTextSize(2);
  canvas.setTextColor(DINO_RED);
  canvas.setCursor(15, 27);
  canvas.print("GAME");
  canvas.setCursor(15, 47);
  canvas.print("OVER");

  canvas.setTextSize(1);
  canvas.setTextColor(DINO_FG);
  canvas.setCursor(18, 70);
  canvas.print("SCORE: ");
  canvas.print((currentGameIndex == 0) ? dinoScore : flappyScore);

  canvas.setTextColor(DINO_RED);
  canvas.setCursor(18, 88);
  canvas.print("B6: PLAY AGAIN");

  canvas.setTextColor(DINO_FG);
  canvas.setCursor(18, 101);
  canvas.print("B5: EXIT");

  pushCanvas();
}

void handleGameOverState() {
  if (digitalRead(btn6) == LOW) {
    playBuzzer(2200, 100);
    delay(150);
    countdownStep = 3;
    countdownTimer = millis();

    if (currentGameIndex == 0) {
      resetDinoGame();
      currentState = STATE_DINO_COUNTDOWN;
    } else {
      resetFlappyGame();
      currentState = STATE_FLAPPY_COUNTDOWN;
    }
    drawCountdownScreen(countdownStep);
  } else if (digitalRead(btn5) == LOW) {
    playBuzzer(1200, 100);
    delay(150);
    currentState = STATE_MENU;
    menuVisualPos = (float)currentGameIndex;
    drawGameMenu();
  }
}

void drawConfirmExitScreen() {
  canvas.fillScreen(DINO_BG);
  canvas.drawRect(8, 18, 112, 86, DINO_FG);

  canvas.setTextSize(1);
  canvas.setTextColor(DINO_FG);
  canvas.setCursor(32, 29);
  canvas.print("EXIT GAME?");

  canvas.setCursor(29, 45);
  canvas.print("Are you sure?");

  drawChoiceButton(17, 67, "STAY", !exitChoice);
  drawChoiceButton(68, 67, "EXIT", exitChoice);

  pushCanvas();
}

void drawChoiceButton(int x, int y, const char* label, bool selected) {
  if (selected) {
    canvas.fillRect(x, y, 43, 21, DINO_FG);
    canvas.setTextColor(DINO_BG);
    canvas.drawRect(x, y, 43, 21, DINO_FG);
  } else {
    canvas.fillRect(x, y, 43, 21, DINO_BG);
    canvas.setTextColor(DINO_FG);
    canvas.drawRect(x, y, 43, 21, DINO_FG);
  }
  canvas.setCursor(x + 8, y + 7);
  canvas.print(label);
}

void handleConfirmExitState() {
  int xVal = analogRead(joyX);

  if (xVal < 1000) {
    exitChoice = false;
    playBuzzer(1500, 30);
    drawConfirmExitScreen();
    delay(180);
  } else if (xVal > 3000) {
    exitChoice = true;
    playBuzzer(1500, 30);
    drawConfirmExitScreen();
    delay(180);
  }

  if (digitalRead(btn4) == LOW) {
    playBuzzer(2000, 100);
    delay(150);

    if (exitChoice) {
      currentState = STATE_MENU;
      menuVisualPos = (float)currentGameIndex;
      drawGameMenu();
    } else {
      if (currentGameIndex == 0) {
        currentState = STATE_DINO_PLAYING;
      } else if (currentGameIndex == 1) {
        currentState = STATE_FLAPPY_PLAYING;
      } else if (currentGameIndex == 2) {
        currentState = STATE_TIME_PLAYING;
      }
    }
  }
}
