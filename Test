void drawEmber(int x, int y, uint16_t coreColor, unsigned long t) {
  canvas.fillCircle(x, y, 4, ST7735_YELLOW);
  canvas.fillCircle(x, y, 2, coreColor);
  if ((t / 60) % 3 == 0) {
    canvas.drawPixel(x + (((t / 30) % 2) ? 3 : -3), y - 3, ST7735_YELLOW);
  }
}

unsigned long typedMessageDuration(const char* msg, unsigned long typeMs, unsigned long holdMs, unsigned long eraseMs) {
  unsigned long len = strlen(msg);
  return (len * typeMs) + holdMs + (len * eraseMs);
}

void drawTypedMessage(const char* msg, int y, unsigned long elapsedInPhase,
                       unsigned long typeMs, unsigned long holdMs, unsigned long eraseMs,
                       uint16_t color) {
  int len = strlen(msg);
  unsigned long typeDur = (unsigned long)len * typeMs;
  unsigned long holdEnd = typeDur + holdMs;
  unsigned long totalDur = holdEnd + ((unsigned long)len * eraseMs);

  int visibleChars;
  if (elapsedInPhase < typeDur) {
    visibleChars = elapsedInPhase / typeMs;
  } else if (elapsedInPhase < holdEnd) {
    visibleChars = len;
  } else if (elapsedInPhase < totalDur) {
    unsigned long eraseElapsed = elapsedInPhase - holdEnd;
    int erased = eraseElapsed / eraseMs;
    visibleChars = len - erased;
  } else {
    visibleChars = 0;
  }

  if (visibleChars < 0) visibleChars = 0;
  if (visibleChars > len) visibleChars = len;
  if (visibleChars == 0) return;

  char buf[32];
  int n = (visibleChars < 31) ? visibleChars : 31;
  strncpy(buf, msg, n);
  buf[n] = '\0';

  int textX = 64 - (len * 6) / 2;
  canvas.setTextSize(1);
  canvas.setTextColor(color);
  canvas.setCursor(textX, y);
  canvas.print(buf);

  if (visibleChars < len) {
    if ((elapsedInPhase / 200) % 2 == 0) {
      int cursorX = textX + visibleChars * 6;
      canvas.drawFastVLine(cursorX, y, 8, color);
    }
  }
}

void drawWelcomeScreen() {
  canvas.fillScreen(ST7735_BLACK);

  unsigned long elapsed = millis() - welcomeAnimTimer;
  float duration = 3600.0;
  float p = (float)elapsed / duration;
  if (p > 1.0) p = 1.0;

  unsigned long idleTime = (p >= 1.0) ? (elapsed - 3600) : 0;
  bool attractModeActive = (idleTime > 15000);

  const unsigned long T_EMERGE  = 500;
  const unsigned long T_TRAVEL1 = 900;
  const unsigned long T_BURN1   = 2700;
  const unsigned long T_TRAVEL2 = 3100;
  const unsigned long T_BURN2   = 4900;

  const unsigned long MSG_TYPE_MS  = 90;
  const unsigned long MSG_HOLD_MS  = 700;
  const unsigned long MSG_ERASE_MS = 45;
  const char* attractMsg1 = "SCARED TO PLAY?";
  const char* attractMsg2 = "WAKE UP, LAZY!";
  const char* attractMsg3 = "PRESS B4 TO START";

  unsigned long msg1Dur = typedMessageDuration(attractMsg1, MSG_TYPE_MS, MSG_HOLD_MS, MSG_ERASE_MS);
  unsigned long msg2Dur = typedMessageDuration(attractMsg2, MSG_TYPE_MS, MSG_HOLD_MS, MSG_ERASE_MS);
  unsigned long msg3Dur = ((unsigned long)strlen(attractMsg3) * MSG_TYPE_MS) + 2200;

  unsigned long T_MSG1_END = T_BURN2    + msg1Dur;
  unsigned long T_MSG2_END = T_MSG1_END + msg2Dur;
  unsigned long T_MSG3_END = T_MSG2_END + msg3Dur;

  if (attractModeActive) aggroTime = idleTime - 15000;

  bool welcomeBurnt  = attractModeActive && aggroTime >= T_BURN1;
  bool nintendoBurnt = attractModeActive && aggroTime >= T_BURN2;

  if (idleTime > 0) {
    for (int i = 0; i < 15; i++) {
      int sx = 8 + (i * 137) % 112;
      int sy = ( (i * 93) + (idleTime / (20 + (i % 3) * 10)) ) % 128;

      if (sx > 4 && sx < 124 && sy > 4 && sy < 124) {
         canvas.drawPixel(sx, sy, (i % 2 == 0) ? ST7735_CYAN : 0x4208);
      }
    }
  }

  int bw = 3;
  canvas.fillRect(0, 0, 64, bw, ST7735_RED);
  canvas.fillRect(0, 128 - bw, 64, bw, ST7735_RED);
  canvas.fillRect(0, 0, bw, 128, ST7735_RED);

  canvas.fillRect(64, 0, 64, bw, ST7735_BLUE);
  canvas.fillRect(64, 128 - bw, 64, bw, ST7735_BLUE);
  canvas.fillRect(128 - bw, 0, bw, 128, ST7735_BLUE);

  canvas.drawFastHLine(bw, bw, 64 - bw, ST7735_WHITE);
  canvas.drawFastHLine(bw, 127 - bw, 64 - bw, ST7735_WHITE);
  canvas.drawFastVLine(bw, bw, 128 - (2 * bw), ST7735_WHITE);

  canvas.drawFastHLine(64, bw, 64 - bw, ST7735_CYAN);
  canvas.drawFastHLine(64, 127 - bw, 64 - bw, ST7735_CYAN);
  canvas.drawFastVLine(127 - bw, bw, 128 - (2 * bw), ST7735_CYAN);

  if (elapsed >= 900 && welcomeSoundStep == 0) { playBuzzer(523, 30); welcomeSoundStep = 1; }
  if (elapsed >= 1800 && welcomeSoundStep == 1) { playBuzzer(659, 30); welcomeSoundStep = 2; }
  if (elapsed >= 2700 && welcomeSoundStep == 2) { playBuzzer(784, 30); welcomeSoundStep = 3; }
  if (elapsed >= 3600 && welcomeSoundStep == 3) { playBuzzer(1760, 15); delay(15); playBuzzer(2637, 25); welcomeSoundStep = 4; }

  float logoP = (p >= 0.25) ? 1.0 : (p / 0.25);
  float easeLogo = 1.0 - (1.0 - logoP) * (1.0 - logoP);
  int joyYOffset = -35 + (int)(easeLogo * 50.0);

  int joyRedX = 42;
  int joyBlueX = 66;

  canvas.fillRoundRect(joyRedX, joyYOffset, 18, 30, 5, ST7735_RED);
  canvas.fillRoundRect(joyBlueX, joyYOffset, 18, 30, 5, ST7735_BLUE);

  int leftStickY = joyYOffset + 9;
  int rightStickY = joyYOffset + 21;

  canvas.fillCircle(joyRedX + 9, leftStickY, 3, ST7735_BLACK);
  canvas.fillCircle(joyBlueX + 9, rightStickY, 3, ST7735_BLACK);

  if (p > 0.25 && !welcomeBurnt) {
    if (!attractModeActive) {
      float text1P = (p >= 0.50) ? 1.0 : ((p - 0.25) / 0.25);
      float easeText1 = 1.0 - (1.0 - text1P) * (1.0 - text1P);
      int welcomeCurrentX = 128 - (int)(easeText1 * (128 - 22));

      canvas.setTextSize(2);
      canvas.setCursor(welcomeCurrentX, 52);
      canvas.setTextColor(ST7735_RED);
      canvas.print("WEL");
      canvas.setTextColor(ST7735_BLUE);
      canvas.print("COME");
    } else {
      canvas.setTextSize(2);
      canvas.setCursor(22, 52);
      canvas.setTextColor(ST7735_RED);
      canvas.print("WEL");
      canvas.setTextColor(ST7735_BLUE);
      canvas.print("COME");
    }
  }

  if (p > 0.50 && !nintendoBurnt) {
    if (!attractModeActive) {
      float text2P = (p >= 0.75) ? 1.0 : ((p - 0.50) / 0.25);
      float easeText2 = 1.0 - (1.0 - text2P) * (1.0 - text2P);
      int nsCurrentX = -100 + (int)(easeText2 * (18 - (-100)));

      canvas.setTextSize(1);
      canvas.setCursor(nsCurrentX, 75);
      canvas.setTextColor(ST7735_RED);
      canvas.print("NINT");
      canvas.setTextColor(ST7735_BLUE);
      canvas.print("ENDO ");
      canvas.setTextColor(ST7735_RED);
      canvas.print("SW");
      canvas.setTextColor(ST7735_BLUE);
      canvas.print("ITCH");
    } else {
      canvas.setTextSize(1);
      canvas.setCursor(18, 75);
      canvas.setTextColor(ST7735_RED);
      canvas.print("NINT");
      canvas.setTextColor(ST7735_BLUE);
      canvas.print("ENDO ");
      canvas.setTextColor(ST7735_RED);
      canvas.print("SW");
      canvas.setTextColor(ST7735_BLUE);
      canvas.print("ITCH");
    }
  }

  int boxCurrentY = 94;
  if (p > 0.75) {
    float startP = (p >= 1.0) ? 1.0 : ((p - 0.75) / 0.25);
    float easeStart = 1.0 - (1.0 - startP) * (1.0 - startP);
    boxCurrentY = 140 - (int)(easeStart * (140 - 94));

    canvas.drawFastVLine(8, boxCurrentY, 18, ST7735_RED);
    canvas.drawFastHLine(8, boxCurrentY, 56, ST7735_RED);
    canvas.drawFastHLine(8, boxCurrentY + 17, 56, ST7735_RED);

    canvas.drawFastVLine(120, boxCurrentY, 18, ST7735_BLUE);
    canvas.drawFastHLine(64, boxCurrentY, 56, ST7735_BLUE);
    canvas.drawFastHLine(64, boxCurrentY + 17, 56, ST7735_BLUE);

    bool showText = true;
    if (idleTime > 0 && !attractModeActive) {
        showText = (idleTime % 1200) < 800;
    }

    if (showText && !attractModeActive) {
        canvas.setTextSize(1);
        canvas.setCursor(20, boxCurrentY + 5);
        canvas.setTextColor(ST7735_RED);
        canvas.print("PRESS ");
        canvas.print("T");
        canvas.setTextColor(ST7735_BLUE);
        canvas.print("o");
        canvas.setTextColor(ST7735_BLUE);
        canvas.print(" START");
    }
  }

  if (attractModeActive) {
    canvas.drawFastVLine(8, 94, 18, ST7735_RED);
    canvas.drawFastHLine(8, 94, 56, ST7735_RED);
    canvas.drawFastHLine(8, 94 + 17, 56, ST7735_RED);

    canvas.drawFastVLine(120, 94, 18, ST7735_BLUE);
    canvas.drawFastHLine(64, 94, 56, ST7735_BLUE);
    canvas.drawFastHLine(64, 94 + 17, 56, ST7735_BLUE);

    if ((aggroTime / 500) % 2 == 0) {
      canvas.setTextSize(1);
      canvas.setCursor(20, 94 + 5);
      canvas.setTextColor(ST7735_RED);
      canvas.print("PRESS TO START");
    }

    if (aggroTime < T_EMERGE) {
      float pe = (float)aggroTime / (float)T_EMERGE;
      float easeE = pe * pe * (3.0 - 2.0 * pe);

      int cx = 64, cy = 30;
      int r = (int)(easeE * 4.0);

      if (pe < 0.75) {
        for (int i = 0; i < 6; i++) {
          float ang = (i * 60) * 0.0174533;
          int px = cx + (int)(cos(ang) * easeE * 10.0);
          int py = cy + (int)(sin(ang) * easeE * 10.0);
          canvas.drawPixel(px, py, (i % 2 == 0) ? ST7735_RED : ST7735_BLUE);
        }
      }

      canvas.fillCircle(cx - 3, cy, r, ST7735_YELLOW);
      canvas.fillCircle(cx - 3, cy, max(0, r - 2), ST7735_RED);
      canvas.fillCircle(cx + 3, cy, r, ST7735_YELLOW);
      canvas.fillCircle(cx + 3, cy, max(0, r - 2), ST7735_BLUE);

      if (aggroTime < 40) { playBuzzer(1200, 30); }
    }
    else if (aggroTime < T_TRAVEL1) {
      float pt = (float)(aggroTime - T_EMERGE) / (float)(T_TRAVEL1 - T_EMERGE);
      float easeT = 1.0 - (1.0 - pt) * (1.0 - pt);

      int dotY = 30 + (int)(easeT * (60 - 30));

      if (((aggroTime - T_EMERGE) / 40) % 2 == 0) {
        canvas.drawPixel(58 + random(0, 4), dotY - 4, ST7735_CYAN);
        canvas.drawPixel(70 - random(0, 4), dotY - 4, ST7735_CYAN);
      }

      drawEmber(61, dotY, ST7735_RED, aggroTime);
      drawEmber(67, dotY, ST7735_BLUE, aggroTime);
    }
    else if (aggroTime < T_BURN1) {
      float pb = (float)(aggroTime - T_TRAVEL1) / (float)(T_BURN1 - T_TRAVEL1);
      if (pb > 1.0) pb = 1.0;
      float easeB = pb * pb * (3.0 - 2.0 * pb);

      int redX  = 64 - (int)(easeB * (64 - 22));
      int blueX = 64 + (int)(easeB * (106 - 64));
      int dotY  = 60 + (int)(sin(aggroTime * 0.02) * 2.0);

      canvas.fillRect(redX, 51, 64 - redX, 18, ST7735_BLACK);
      canvas.fillRect(64, 51, blueX - 64, 18, ST7735_BLACK);

      drawEmber(redX, dotY, ST7735_RED, aggroTime);
      drawEmber(blueX, dotY, ST7735_BLUE, aggroTime);

      if ((aggroTime - T_TRAVEL1) % 140 < 35) {
        playBuzzer(random(300, 650), 18);
      }
    }
    else if (aggroTime < T_TRAVEL2) {
      float pt2 = (float)(aggroTime - T_BURN1) / (float)(T_TRAVEL2 - T_BURN1);
      float easeT2 = 1.0 - (1.0 - pt2) * (1.0 - pt2);

      int redX  = 22 + (int)(easeT2 * (64 - 22));
      int blueX = 106 - (int)(easeT2 * (106 - 64));
      int dotY  = 60 + (int)(easeT2 * (79 - 60));

      drawEmber(redX, dotY, ST7735_RED, aggroTime);
      drawEmber(blueX, dotY, ST7735_BLUE, aggroTime);
    }
    else if (aggroTime < T_BURN2) {
      float pb2 = (float)(aggroTime - T_TRAVEL2) / (float)(T_BURN2 - T_TRAVEL2);
      if (pb2 > 1.0) pb2 = 1.0;
      float easeB2 = pb2 * pb2 * (3.0 - 2.0 * pb2);

      int redX  = 64 - (int)(easeB2 * (64 - 18));
      int blueX = 64 + (int)(easeB2 * (108 - 64));
      int dotY  = 79 + (int)(sin(aggroTime * 0.02) * 1.5);

      canvas.fillRect(redX, 74, 64 - redX, 10, ST7735_BLACK);
      canvas.fillRect(64, 74, blueX - 64, 10, ST7735_BLACK);

      drawEmber(redX, dotY, ST7735_RED, aggroTime);
      drawEmber(blueX, dotY, ST7735_BLUE, aggroTime);

      if ((aggroTime - T_TRAVEL2) % 140 < 35) {
        playBuzzer(random(300, 650), 18);
      }
    }
    else if (aggroTime < T_MSG1_END) {
      unsigned long localT = aggroTime - T_BURN2;
      drawTypedMessage(attractMsg1, 58, localT, MSG_TYPE_MS, MSG_HOLD_MS, MSG_ERASE_MS, ST7735_RED);
      if (localT < (unsigned long)strlen(attractMsg1) * MSG_TYPE_MS && (localT % MSG_TYPE_MS) < 20) {
        playBuzzer(1400, 15);
      }
    }
    else if (aggroTime < T_MSG2_END) {
      unsigned long localT = aggroTime - T_MSG1_END;
      drawTypedMessage(attractMsg2, 58, localT, MSG_TYPE_MS, MSG_HOLD_MS, MSG_ERASE_MS, ST7735_WHITE);
      if (localT < (unsigned long)strlen(attractMsg2) * MSG_TYPE_MS && (localT % MSG_TYPE_MS) < 20) {
        playBuzzer(700, 20);
      }
    }
    else if (aggroTime < T_MSG3_END) {
      unsigned long localT = aggroTime - T_MSG2_END;
      drawTypedMessage(attractMsg3, 58, localT, MSG_TYPE_MS, 2200, 0, ST7735_BLUE);
      if (localT < (unsigned long)strlen(attractMsg3) * MSG_TYPE_MS && (localT % MSG_TYPE_MS) < 20) {
        playBuzzer(1600, 15);
      }
    }
    else {
      unsigned long harasTime = aggroTime - T_MSG3_END;

