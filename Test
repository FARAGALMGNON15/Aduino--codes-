void handleWelcomeState() {
  unsigned long now = millis();
  unsigned long elapsed = now - welcomeAnimTimer;

  bool allButtonsReleased =
    digitalRead(btn4) == HIGH && digitalRead(btn5) == HIGH &&
    digitalRead(btn6) == HIGH && digitalRead(btnLeft) == HIGH &&
    digitalRead(joySW) == HIGH;

  int xVal = analogRead(joyX);
  int yVal = analogRead(joyY);
  bool joystickCentered = (xVal >= 1000 && xVal <= 3000 && yVal >= 1000 && yVal <= 3000);

  if (waitingForButtonRelease) {
    if (allButtonsReleased && joystickCentered) {
      waitingForButtonRelease = false;
    }
    drawWelcomeScreen();
    return;
  }

  if (elapsed >= 3600 && !waitingForButtonRelease) {
    drawWelcomeScreen();

    bool buttonPressed =
      digitalRead(btn4) == LOW || digitalRead(btn5) == LOW ||
      digitalRead(btn6) == LOW || digitalRead(btnLeft) == LOW ||
      digitalRead(joySW) == LOW;

    bool joystickMoved = xVal < 500 || xVal > 3500 || yVal < 500 || yVal > 3500;

    if (buttonPressed || joystickMoved) {
      digitalWrite(led1, HIGH);
      digitalWrite(led2, HIGH);
      playBuzzer(2500, 100);
      delay(100);
      digitalWrite(led1, LOW);
      digitalWrite(led2, LOW);

      currentState = STATE_JOYSTICK_TUTORIAL;
      currentGameIndex = 0;
      menuVisualPos = 0.0;
      tutorialAnimTimer = millis();
    }
  } else {
    drawWelcomeScreen();
  }
}

