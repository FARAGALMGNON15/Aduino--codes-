  switch (currentState) {
    case STATE_WELCOME:           handleWelcomeState();           break;
    case STATE_JOYSTICK_TUTORIAL: handleJoystickTutorialState(); break;
    case STATE_MENU:              handleMenuState();              break;
    case STATE_GAME_INFO:         handleGameInfoState();          break;
    case STATE_DINO_START:        handleDinoStartState();         break;
    case STATE_DINO_COUNTDOWN:    handleDinoCountdownState();     break;
    case STATE_DINO_PLAYING:      handleDinoPlayingState();       break;
    case STATE_FLAPPY_START:      handleFlappyStartState();       break;
    case STATE_FLAPPY_COUNTDOWN:  handleFlappyCountdownState();   break;
    case STATE_FLAPPY_PLAYING:    handleFlappyPlayingState();     break;
    case STATE_TIME_START:        handleTimeStartState();         break;
    case STATE_TIME_PLAYING:      handleTimePlayingState();       break;
    case STATE_CONFIRM_EXIT:      handleConfirmExitState();       break;
    case STATE_GAMEOVER:          handleGameOverState();          break;
  }
}

