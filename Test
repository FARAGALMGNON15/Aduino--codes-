// =====================================================================
// PLAYING STATES
// =====================================================================
void handleDinoPlayingState() {
  if (digitalRead(btn5) == LOW) {
    playBuzzer(1200, 100);
    currentState = STATE_CONFIRM_EXIT;
    exitChoice = false;
    drawConfirmExitScreen();
    delay(250);
    return;
  }

  unsigned long now = millis();
  if (now - lastFrame < FRAME_TIME) return;
  lastFrame = now;

  int yVal = analogRead(joyY);
  if ((digitalRead(btn4) == LOW || yVal < 1000) && !dinoIsJumping) {
    dinoVY = -7.2;
    dinoIsJumping = true;
    playBuzzer(1800, 40);
  }

  dinoY += dinoVY;
  dinoVY += 0.60;
  if (dinoY >= 85) {
    dinoY = 85;
    dinoVY = 0;
    dinoIsJumping = false;
  }

  for (int i = 0; i < NUM_OBS; i++) {
    obstacles[i].x -= dinoGameSpeed;
    if (obstacles[i].x < -15) {
      obstacles[i].x = 140 + random(45, 95);
      dinoScore += 10;

      if (dinoScore >= 150 && random(0, 6) == 0) {
        obstacles[i].isBird = true;
        obstacles[i].w = 10;
        obstacles[i].h = 8;
        obstacles[i].y = 80;
      } else {
        obstacles[i].isBird = false;
        obstacles[i].w = 8;
        obstacles[i].h = random(12, 18);
        obstacles[i].y = 99 - obstacles[i].h;
      }

      dinoGameSpeed = 2.0 + (dinoScore / 400.0);
      if (dinoGameSpeed > 4.0) dinoGameSpeed = 4.0;
    }

    if (abs((int)dinoX - (int)obstacles[i].x) < 7 && abs((int)dinoY - obstacles[i].y) < 9) {
      if (dinoScore > dinoHighScore) dinoHighScore = dinoScore;
      triggerGameOver();
      return;
    }
  }

  drawDinoGame();
}

void handleFlappyPlayingState() {
  if (digitalRead(btn5) == LOW) {
    playBuzzer(1200, 100);
    currentState = STATE_CONFIRM_EXIT;
    exitChoice = false;
    drawConfirmExitScreen();
    delay(250);
    return;
  }

  unsigned long now = millis();
  if (now - lastFrame < FRAME_TIME) return;
  lastFrame = now;

  if (digitalRead(btn4) == LOW) {
    birdVY = -4.5;
    playBuzzer(1600, 30);
  }

  birdY += birdVY;
  birdVY += 0.45;

  if (birdY < 2) {
    birdY = 2;
    birdVY = 0;
  }
  if (birdY > 115) {
    if (flappyScore > flappyHighScore) flappyHighScore = flappyScore;
    triggerGameOver();
    return;
  }

  pipeX -= flappySpeed;
  if (pipeX < -pipeWidth) {
    pipeX = 128;
    pipeGapY = random(35, 75);
    flappyScore += 10;
    flappySpeed = 1.4 + (flappyScore / 200.0);
    if (flappySpeed > 2.6) flappySpeed = 2.6;
  }

  int birdX = 30;
  if (birdX + 8 > pipeX && birdX < pipeX + pipeWidth) {
    if (birdY < pipeGapY || birdY + 8 > pipeGapY + pipeGapHeight) {
      if (flappyScore > flappyHighScore) flappyHighScore = flappyScore;
      triggerGameOver();
      return;
    }
  }

  drawFlappyGame();
}

