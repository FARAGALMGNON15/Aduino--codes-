void handleMenuState() {
  if (focusAnimActive) {
    unsigned long elapsed = millis() - focusAnimTimer;
    if (elapsed < 250) {
      focusProgress = (float)elapsed / 250.0;
      drawGameMenu();
    } else {
      focusAnimActive = false;
      currentState = STATE_GAME_INFO;
      drawGameInfoScreen();
    }
    return;
  }

  int yVal = analogRead(joyY);
  unsigned long now = millis();

  if (now - lastNavTime > 180) {
    bool navigated = true;

    if (yVal < 1000) {
      currentGameIndex--;
      if (currentGameIndex < 0) currentGameIndex = totalGames - 1;
    } else if (yVal > 3000) {
      currentGameIndex++;
      if (currentGameIndex >= totalGames) currentGameIndex = 0;
    } else {
      navigated = false;
    }

    if (navigated) {
      playBuzzer(1500, 20);
      lastNavTime = now;
    }
  }

  drawGameMenu();

  if (digitalRead(btn5) == LOW) {
    playBuzzer(1000, 60);
    delay(150);
    currentState = STATE_WELCOME;
    welcomeAnimTimer = millis();
    waitingForButtonRelease = true;
    welcomeSoundStep = 0;
    return;
  }

  if (digitalRead(btn6) == LOW) {
    playBuzzer(1800, 60);
    focusAnimActive = true;
    focusAnimTimer = millis();
    focusProgress = 0.0;
    return;
  }

  if (digitalRead(btn4) == LOW) {
    digitalWrite(led1, HIGH);
    digitalWrite(led2, HIGH);
    playBuzzer(2200, 80);
    delay(150);
    digitalWrite(led1, LOW);
    digitalWrite(led2, LOW);

    if (currentGameIndex == 0) {
      resetDinoGame();
      currentState = STATE_DINO_START;
      drawDinoStartScreen();
    } else if (currentGameIndex == 1) {
      resetFlappyGame();
      currentState = STATE_FLAPPY_START;
      drawFlappyStartScreen();
    } else if (currentGameIndex == 2) {
      resetTimeGame();
      currentState = STATE_TIME_START;
      drawTimeStartScreen();
    } else {
      resetDinoGame();
      currentState = STATE_DINO_START;
      drawDinoStartScreen();
    }
  }
}

